#!/usr/bin/env bash
# ============================================================
#  Aion Sincro — pre-commit hook
#  Ejecuta la suite de pruebas completa ANTES de cada commit
#  y bloquea el commit si algo falla.
#
#  Cross-platform: funciona en Git Bash (Windows) y en sh/Linux.
#  - Windows → lanza test_all.cmd (cmd.exe)
#  - Linux/macOS → lanza ./test_all.sh
#
#  Omitir en un commit puntual:  git commit --no-verify
# ============================================================
set -u

# Repo root: git rev-parse es robusto también en worktrees, con fallback
# a la resolución clásica (.git/hooks/../..) si fallara.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

echo ""
echo "============================================================"
echo "  🔒 PRE-COMMIT · AION SINCRÓ — SUITE DE PRUEBAS"
echo "============================================================"
echo ""

fail() {
    echo ""
    echo "  ✘ PRE-COMMIT BLOQUEADO: la suite de pruebas falló."
    echo "    Arregla los errores y vuelve a commitear."
    echo "    (Salto puntual SOLO si sabes lo que haces: git commit --no-verify)"
    echo ""
    exit 1
}

# Detectar plataforma: si existe cmd.exe (Git Bash en Windows) usamos el .cmd
if command -v cmd.exe >/dev/null 2>&1; then
    # En Git Bash de Windows no hay GNU timeout: si la suite se cuelga,
    # usa Ctrl+C (el Ctrl+C del commit abandona el hook y aborta).
    if ! cmd.exe /c test_all.cmd; then
        fail
    fi
else
    if [ ! -x test_all.sh ]; then
        echo "[pre-commit] test_all.sh no es ejecutable — aplicando chmod +x"
        chmod +x test_all.sh
    fi
    # Guarda de timeout (solo si GNU timeout existe): evita que un test
    # colgado bloquee el commit para siempre; falla con BLOQUEADO.
    if command -v timeout >/dev/null 2>&1; then
        if ! timeout 300 ./test_all.sh; then
            fail
        fi
    else
        if ! ./test_all.sh; then
            fail
        fi
    fi
fi

echo ""
echo "  ✔ PRE-COMMIT OK — la suite pasó, el commit continúa"
echo "============================================================"
echo ""
exit 0
