# ============================================================
# Aion Sincro · Docker Compose — Variables de entorno
# ============================================================
# Copia este archivo como .env y rellena las claves que
# quieras usar.  Todas son OPCIONALES: si no pones ninguna,
# Aion arranca en modo demo local (sin IA externa).
#
#   cp docker/.env.example .env
#   nano .env
# ============================================================

# --- Claves de API (opcionales) ---
# Mistral (gratis: https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Groq (gratis: https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter (gratis: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# HuggingFace (gratis: https://huggingface.co/settings/tokens)
HF_TOKEN=

# --- Token del puente (opcional) ---
# Si lo dejas vacío, el puente y el proxy no requerirán token.
BRIDGE_TOKEN=
PROXY_TOKEN=
PIPER_TOKEN=

# --- Puertos (cámbialos si ya están ocupados) ---
APP_PORT=8080
BRIDGE_PORT=8765
PROXY_PORT=8797
PIPER_PORT=8766
